{
  "manifest_version": 3,
  "name": "Arc風スクリーンショット",
  "short_name": "ArcShot",
  "version": "1.0.0",
  "description": "Arcブラウザのようなスクリーンショット。要素をクリックで切り抜き、またはドラッグで範囲を指定して撮影します。",
  "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "スクリーンショットを撮る",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+2",
        "mac": "Command+Shift+2"
      },
      "description": "スクリーンショットを開始"
    }
  }
}
